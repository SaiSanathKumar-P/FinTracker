{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": { "includeFiles": ["views/**", "public/**"] } 
    }
  ],
  "routes": [
    { "handle": "filesystem" }, // This tells Vercel to check for images first
    { "src": "/(.*)", "dest": "server.js" }
  ]
}
